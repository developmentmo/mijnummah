# Copy to .env for docker compose (compose reads .env automatically).
# The Spring `local` profile uses the same defaults, so no app env vars are needed locally.
# NEVER commit a real .env file.

# --- docker compose ---
POSTGRES_DB=mijnummah
POSTGRES_USER=mijnummah
POSTGRES_PASSWORD=mijnummah
POSTGRES_PORT=5434

# --- application (required outside the `local` profile) ---
# SPRING_PROFILES_ACTIVE=local
# DATABASE_URL=jdbc:postgresql://localhost:5434/mijnummah
# DATABASE_USERNAME=mijnummah
# DATABASE_PASSWORD=mijnummah

# Access-token signing secret, >= 32 bytes. Optional in `local` (a dev default exists), REQUIRED elsewhere.
# Generate: openssl rand -base64 48
# JWT_SECRET=

# Browser origins of the admin portal, comma-separated.
# CORS_ALLOWED_ORIGINS=https://beheer.example.nl

# --- first start (optional) ---
# Creates the first platform administrator when none exists. Remove the password after the first start.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Creates the first mosque when no mosque with this slug exists, and makes BOOTSTRAP_MOSQUE_ADMIN_EMAIL its ADMIN.
# BOOTSTRAP_MOSQUE_SLUG=noeroel-islam
# BOOTSTRAP_MOSQUE_NAME=Noeroel Islam
# BOOTSTRAP_MOSQUE_ADMIN_EMAIL=

# OpenAPI document and Swagger UI (on in `local`, off elsewhere unless set).
# API_DOCS_ENABLED=false

# --- email (password reset) ---
# none (default: password reset answers 503), smtp, or log (local development only, nothing is sent).
# MAIL_PROVIDER=smtp
# MAIL_FROM=Noeroel Islam <noreply@example.nl>
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- push notifications ---
# none (default: sending answers 503), fcm, or log (local development only, nothing is sent).
# PUSH_PROVIDER=fcm
# FCM_PROJECT_ID=
# Service-account JSON key file, kept outside the repository (e.g. mounted as a Docker secret).
# FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json

# --- retention (nightly clean-up, see PRIVACY.md); ISO-8601 durations ---
# RETENTION_ENABLED=true
# RETENTION_CRON=0 30 3 * * *
# RETENTION_EXPIRED_SESSIONS=P7D
# RETENTION_EXPIRED_RESET_CODES=P1D
# RETENTION_EVENT_REGISTRATIONS=P365D
# RETENTION_INACTIVE_PUSH_DEVICES=P270D
# RETENTION_PUSH_SENDING_TIMEOUT=PT30M
