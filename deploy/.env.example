# Copy to .env next to docker-compose.prod.yml and fill in. NEVER commit .env.
# Generate secrets with: openssl rand -base64 48

# Version of the images to run (git tag or commit). Rollback = previous tag, see DEPLOYMENT.md.
IMAGE_TAG=latest

# --- database ---
POSTGRES_DB=mijnummah
POSTGRES_USER=mijnummah
POSTGRES_PASSWORD=

# --- backend ---
JWT_SECRET=
# Public address of the admin portal (CORS), e.g. https://beheer.noeroelislam.nl
PORTAL_ORIGIN=
BACKEND_PORT=8080
# Structured logs, one JSON object per line: ecs, logstash or gelf
LOG_FORMAT=ecs

# Email for password reset: none or smtp
MAIL_PROVIDER=none
MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Push notifications: none or fcm. The key file goes in SECRETS_DIR (mounted read-only at /run/secrets).
PUSH_PROVIDER=none
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json
SECRETS_DIR=./secrets

# First start only; remove BOOTSTRAP_ADMIN_PASSWORD afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_MOSQUE_SLUG=noeroel-islam
BOOTSTRAP_MOSQUE_NAME=Noeroel Islam
BOOTSTRAP_MOSQUE_ADMIN_EMAIL=

# --- admin portal ---
# Public address of the backend, e.g. https://api.noeroelislam.nl
API_BASE_URL=
PORTAL_PORT=8081

# --- backups (backup.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
