# Copy to .env next to docker-compose.prod.yml and fill in. NEVER commit .env.
# Generate secrets with: openssl rand -base64 48

# Version of the images to run (git tag or commit). Rollback = previous tag, see DEPLOYMENT.md.
IMAGE_TAG=latest

# --- database ---
POSTGRES_DB=mijnummah
POSTGRES_USER=mijnummah
POSTGRES_PASSWORD=

# --- backend ---
JWT_SECRET=
# Public address of the admin portal (CORS), e.g. https://beheer.mijnummah.nl
PORTAL_ORIGIN=
BACKEND_PORT=8080
# Structured logs, one JSON object per line: ecs, logstash or gelf
LOG_FORMAT=ecs

# Email for password reset: none or smtp
MAIL_PROVIDER=none
MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Push notifications: none or fcm. The key file goes in SECRETS_DIR (mounted read-only at /run/secrets).
PUSH_PROVIDER=none
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json
SECRETS_DIR=./secrets

# First start only; remove BOOTSTRAP_ADMIN_PASSWORD afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional: a first mosque at start-up. Usually empty; mosques join through the portal.
BOOTSTRAP_MOSQUE_SLUG=
BOOTSTRAP_MOSQUE_NAME=
BOOTSTRAP_MOSQUE_ADMIN_EMAIL=

# --- HTTPS (Caddy in this stack) ---
# "caddy" starts the Caddy service, which gets certificates for both domains itself. Leave empty when a reverse
# proxy on the host already does HTTPS (forward to BACKEND_PORT and PORTAL_PORT).
COMPOSE_PROFILES=caddy
# Domains without https://, e.g. api.mijnummah.nl and beheer.mijnummah.nl. DNS must point at this server.
API_DOMAIN=
PORTAL_DOMAIN=
# Let's Encrypt sends certificate warnings here.
ACME_EMAIL=

# --- admin portal ---
# Public address of the backend, e.g. https://api.mijnummah.nl
API_BASE_URL=
PORTAL_PORT=8081

# --- backups (backup.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30

# --- monitoring (check.sh, every 5 minutes from cron) ---
# Optional ping URL of an external monitor (e.g. healthchecks.io): pinged when all checks pass, <url>/fail otherwise.
# Without it check.sh only writes to its log and exits with an error code.
HEALTHCHECK_PING_URL=
DISK_MAX_PERCENT=85
BACKUP_MAX_AGE_HOURS=26

# --- off-site backup (offsite-backup.sh, restic in a container) ---
# Encrypted copy of BACKUP_DIR outside this server, e.g. an S3 bucket in the EU: s3:https://<endpoint>/<bucket>
RESTIC_REPOSITORY=
# Keep this password in the password vault too: without it the off-site backup cannot be read.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OFFSITE_KEEP_DAYS=30
